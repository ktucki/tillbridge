# cmake -DTB=<path to tillbridge> -DDATA=<tests/data> -DWORK=<scratch dir> -P cli_smoke.cmake
file(MAKE_DIRECTORY ${WORK})
function(tb)
  execute_process(COMMAND ${TB} ${ARGN} WORKING_DIRECTORY ${WORK} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "tillbridge ${ARGN} failed (${rc}):\n${out}\n${err}")
  endif()
  message(STATUS "tillbridge ${ARGV0}: ok")
endfunction()
set(R ${DATA}/regression)
tb(version)
tb(bed raw.txt --Lx 0.3 --Ly 0.2 --depth 0.05 --radius 0.012 --clods --seed 5)
tb(run raw.txt none settle --set t_end=0.05 dt=5e-5 t_tool=99 Lx=0.3 Ly=0.2 Lz=0.3 out_dt=0.01)
tb(prepare settle_state.txt prepared.txt --depth 0.04 --furrow-edge 0.05 --furrow-bottom 0.0 --fix-below 0.01)
tb(shape mouldboard mb.txt --stl mb.stl)
tb(shape chisel ch.txt)
tb(tool mb.stl mb2.txt --unit 1.0 --translate 0.1 0.0 0.0 --max-edge 0.05)
tb(run ${R}/bed.txt ${R}/tine.txt r --params ${R}/params.txt --set t_end=0.12 avg_x0=0.03 avg_x1=0.11 --threads 2)
tb(energy r ${R}/tine.txt --speed 1.0 --bed ${R}/bed.txt --x0 0.03 --x1 0.11)
tb(wear r ${R}/tine.txt --smooth 1 --out wear.csv)
tb(loads r ${R}/tine.txt --ref 0 0.125 0.3)
tb(fem ${DATA}/bar.cdb --fixed CLAMP --loaded FACE --force -100 0 30 --ref 0 0 0 --vtk bar.vtk)
tb(convert ${DATA}/bar.cdb bar.msh)
tb(fem bar.msh --fixed CLAMP --loaded FACE --force -100 0 30 --ref 0 0 0 --E 200000 --ccx bar.inp)
tb(fatigue r --x0 0.03 --x1 0.11 --sigma-ref 80 --speed 1.0 --detail 71)
file(WRITE ${WORK}/cal.txt "bed ${R}/bed.txt\ntool ${R}/tine.txt\nparams ${R}/params.txt\nset t_end 0.09\nset avg_x0 0.03\nset avg_x1 0.08\nparam mu_pp 0.3 0.7\ntarget draft 20.0\ninit 3\niter 1\nlog cal.log\nout cal\n")
tb(calibrate cal.txt)
foreach(f cal.log r_force.csv r_tri.csv r_triW.csv r_state.txt r_vel.txt r_depart.txt r_summary.txt r_params.txt wear.csv bar.vtk)
  if(NOT EXISTS ${WORK}/${f})
    message(FATAL_ERROR "missing output ${f}")
  endif()
endforeach()
